    <string name="vd_detection_interval">فاصل الاكتشاف</string>
    <string name="vd_detection_interval_desc">%1$d مللي ثانية بين كل فحص للصورة</string>
    <string name="vd_confirmation_time">وقت التأكيد</string>
    <string name="vd_confirmation_time_desc">%1$d مللي ثانية من الحركة المستمرة المطلوبة</string>
    <string name="vd_no_motion_timeout">مهلة انعدام الحركة</string>
    <string name="vd_no_motion_timeout_desc">%1$d مللي ثانية من السكون قبل ما يتوقف</string>
    <string name="vd_note">ملاحظة: ده بيستخدم تحليل حركة الشاشة على الجهاز نفسه، مش تصنيف مثالي للفيديو - خلفية متحركة أو أنيميشن سريع ممكن يتسجل كحركة برضه. عدّل الحساسية والتوقيت فوق لو حساس أوي أو بطيء أوي.</string>
